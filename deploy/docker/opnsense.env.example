# OPNsense pusher. Copy to opnsense.env and keep it 0600.
NETPULSE_SERVER=http://netpulse:3000
NETPULSE_INTERVAL=30s
NETPULSE_SLUG=opnsense
NETPULSE_TOKEN=

# Address the OPNsense GUI listens on (System > Settings > Administration).
OPNSENSE_HOST=https://192.168.1.1
# API key and secret of a dedicated read-only user (opnsense/README.md lists the privileges).
OPNSENSE_USER=
OPNSENSE_PASS=

# Trust for the GUI certificate. Use one of:
#   OPNSENSE_CERT_FP   SHA-256 of the leaf certificate (./register.sh fingerprint prints it)
#   OPNSENSE_CA_CERT   PEM file of the CA that signed it (mount it into the container)
#   OPNSENSE_INSECURE=1 last resort, no verification
OPNSENSE_CERT_FP=

# Empty = use the interface OPNsense assigns as "wan".
OPNSENSE_WAN_INTERFACE=
# Logical interfaces for per-client traffic, e.g. lan,opt1,opt2.
OPNSENSE_TRAFFIC_INTERFACES=lan
