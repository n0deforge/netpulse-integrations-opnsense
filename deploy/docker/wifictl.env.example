# Wi-Fi controller pusher. Copy to wifictl.env and keep it 0600.
NETPULSE_SERVER=http://netpulse:3000
NETPULSE_INTERVAL=30s

WIFICTL_URL=http://host.docker.internal:8088
WIFICTL_PASSWORD=
# Controller AP ids, then one slug and token per id (upper-cased).
WIFICTL_UNITS=ap1,ap2
WIFICTL_AP1_SLUG=
WIFICTL_AP1_TOKEN=
WIFICTL_AP2_SLUG=
WIFICTL_AP2_TOKEN=
